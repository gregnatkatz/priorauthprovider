# Azure AI Foundry Configuration
PROJECT_ENDPOINT=https://pharma-agents-jnj-resource.services.ai.azure.com
MODEL_DEPLOYMENT_NAME=gpt-4.1

# Azure Subscription Details
SUBSCRIPTION_ID=edc5bc65-467b-4060-9bb2-285374d299df
RESOURCE_GROUP=rg-gregorykatz-2103
PROJECT_NAME=pharma-agents-jnj

# MCP Server Configuration
MCP_SERVER_URL=https://<your-function-app>.azurewebsites.net/api/mcp
MCP_SERVER_LABEL=denial-intelligence

# Azure AI Search (for Policy RAG)
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-api-key>
AZURE_SEARCH_INDEX_NAME=payer-policies

# Azure SQL Database
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<database>;Uid=<username>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# OpenAI API Keys (for direct model access)
OPENAI_API_KEY=<your-openai-api-key>
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/

# Function App Settings
FUNCTIONS_WORKER_RUNTIME=python
AzureWebJobsStorage=<your-storage-connection-string>
WEBSITE_RUN_FROM_PACKAGE=1

# Logging
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>
